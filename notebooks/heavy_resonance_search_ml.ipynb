   "source": [
    "## 2.3 Weighted Yield and Applying the cuts\n",
    " In this part, i will apply cut to the datasets and calculate the yeild before and after the cut and than I will make its summary."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cd02656c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Baseline cuts\n",
    "\n",
    "# I define one function for the cut-based selection so I can apply the same cuts everywhere\n",
    "def apply_cuts(df):\n",
    "    return (\n",
    "        (df[\"lep1_pt\"] > 135000) &\n",
    "        (df[\"lep2_pt\"] > 50000) &\n",
    "        (df[\"fatjet_pt\"] > 260000) &\n",
    "        (np.abs(df[\"fatjet_eta\"]) < 2.3) &\n",
    "        (df[\"fatjet_D2\"] < 2.2) &\n",
    "        (df[\"Zll_mass\"] > 78000) &\n",
    "        (df[\"Zll_mass\"] < 107000) &\n",
    "        (df[\"Zll_pt\"] > 150000) &\n",
    "        (df[\"MET\"] < 100000)\n",
    "    )\n",
    "\n",
    "# Keep a copy of the original samples before any selection\n",
    "signal_before_cuts = signal_df.copy()\n",
    "diboson_before_cuts = diboson_df.copy()\n",
    "zjets_before_cuts = zjets_df.copy()\n",
    "top_before_cuts = top_df.copy()\n",
    "\n",
    "# Apply the baseline cuts to each sample separately\n",
    "signal_after_cuts = signal_before_cuts[apply_cuts(signal_before_cuts)].copy()\n",
    "diboson_after_cuts = diboson_before_cuts[apply_cuts(diboson_before_cuts)].copy()\n",
    "zjets_after_cuts = zjets_before_cuts[apply_cuts(zjets_before_cuts)].copy()\n",
    "top_after_cuts = top_before_cuts[apply_cuts(top_before_cuts)].copy()\n",
    "\n",
    "# Combine the three background samples before cuts\n",
    "background_before_cuts = pd.concat(\n",
    "    [diboson_before_cuts, zjets_before_cuts, top_before_cuts],\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "# Combine the three background samples again after cuts\n",
    "background_after_cuts = pd.concat(\n",
    "    [diboson_after_cuts, zjets_after_cuts, top_after_cuts],\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "# Convert the reconstructed mass from MeV to GeV for easier plotting later\n",
    "for df in [\n",
    "    signal_before_cuts,\n",
    "    diboson_before_cuts,\n",
    "    zjets_before_cuts,\n",
    "    top_before_cuts,\n",
    "    signal_after_cuts,\n",
    "    diboson_after_cuts,\n",
    "    zjets_after_cuts,\n",
    "    top_after_cuts,\n",
    "    background_before_cuts,\n",
    "    background_after_cuts,\n",
    "]:\n",
    "    df[\"reco_zv_mass_gev\"] = df[\"reco_zv_mass\"] / 1000.0\n",
    "\n",
    "# In this project, the important yield is the weighted yield, not just the row count\n",
    "def weighted_yield(df):\n",
    "    return df[\"FullEventWeight\"].sum()\n",
    "\n",
    "# Calculate weighted yields before cuts\n",
    "signal_yield_before = weighted_yield(signal_before_cuts)\n",
    "diboson_yield_before = weighted_yield(diboson_before_cuts)\n",
    "zjets_yield_before = weighted_yield(zjets_before_cuts)\n",
    "top_yield_before = weighted_yield(top_before_cuts)\n",
    "background_yield_before = weighted_yield(background_before_cuts)\n",
    "\n",
    "# Calculate weighted yields after cuts\n",
    "signal_yield_after = weighted_yield(signal_after_cuts)\n",
    "diboson_yield_after = weighted_yield(diboson_after_cuts)\n",
    "zjets_yield_after = weighted_yield(zjets_after_cuts)\n",
    "top_yield_after = weighted_yield(top_after_cuts)\n",
    "background_yield_after = weighted_yield(background_after_cuts)\n",
    "\n",
    "# Print the weighted event yields before selection\n",
    "print(\"\\nBefore cuts\")\n",
    "print(f\"Signal: {signal_yield_before:,.3f}\")\n",
    "print(f\"Diboson: {diboson_yield_before:,.3f}\")\n",
    "print(f\"Z+jets: {zjets_yield_before:,.3f}\")\n",
    "print(f\"Top: {top_yield_before:,.3f}\")\n",
    "print(f\"Total background: {background_yield_before:,.3f}\")\n",
    "\n",
    "# Print the weighted event yields after selection\n",
    "print(\"\\nAfter cuts\")\n",
    "print(f\"Signal: {signal_yield_after:,.3f}\")\n",
    "print(f\"Diboson: {diboson_yield_after:,.3f}\")\n",
    "print(f\"Z+jets: {zjets_yield_after:,.3f}\")\n",
    "print(f\"Top: {top_yield_after:,.3f}\")\n",
    "print(f\"Total background: {background_yield_after:,.3f}\")\n",
    "\n",
    "# Work out how much signal and background survive the cuts\n",
    "signal_efficiency = signal_yield_after / signal_yield_before\n",
    "background_efficiency = background_yield_after / background_yield_before\n",
    "\n",
    "# Also compare simple sensitivity numbers before and after the cuts\n",
    "signal_to_background_before = signal_yield_before / background_yield_before\n",
    "signal_to_background_after = signal_yield_after / background_yield_after\n",
    "\n",
    "signal_over_sqrt_background_before = signal_yield_before / np.sqrt(background_yield_before)\n",
    "signal_over_sqrt_background_after = signal_yield_after / np.sqrt(background_yield_after)\n",
    "\n",
    "# Print a short cut summary\n",
    "print(\"\\nCut summary\")\n",
    "print(f\"Signal efficiency: {signal_efficiency:.4f}\")\n",
    "print(f\"Background efficiency: {background_efficiency:.4f}\")\n",
    "print(f\"S/B before: {signal_to_background_before:.6f}\")\n",
    "print(f\"S/B after: {signal_to_background_after:.6f}\")\n",
    "print(f\"S/sqrt(B) before: {signal_over_sqrt_background_before:.6f}\")\n",
    "print(f\"S/sqrt(B) after: {signal_over_sqrt_background_after:.6f}\")\n",
    "\n",
    "# Put the main weighted yields into a small summary table\n",
    "selection_summary = pd.DataFrame(\n",
    "    {\n",
    "        \"before\": [\n",
    "            signal_yield_before,\n",
    "            diboson_yield_before,\n",
    "            zjets_yield_before,\n",
    "            top_yield_before,\n",
    "            background_yield_before,\n",
    "        ],\n",
    "        \"after\": [\n",
    "            signal_yield_after,\n",
    "            diboson_yield_after,\n",
    "            zjets_yield_after,\n",
    "            top_yield_after,\n",
    "            background_yield_after,\n",
    "        ],\n",
    "    },\n",
    "    index=[\"Signal\", \"Diboson\", \"Z+jets\", \"Top\", \"Total background\"],\n",
    ")\n",
    "\n",
    "selection_summary"
   ]
  },
  {
   "cell_type": "markdown",
