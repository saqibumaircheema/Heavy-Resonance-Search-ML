   "source": [
    "# Make smooth x-values so the fitted curves look clean on the plots\n",
    "x_signal_plot = np.linspace(850, 1150, 400)\n",
    "y_signal_plot = gaussian(x_signal_plot, signal_amplitude_fit, signal_mean_fit, signal_sigma_fit)\n",
    "\n",
    "x_background_plot = np.linspace(700, 1600, 500)\n",
